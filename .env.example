# Скопируйте этот файл в .env и впишите свои значения.
YANDEX_MUSIC_TOKEN=        # OAuth-токен, добывается вручную из DevTools (см. README)
YANDEX_MUSIC_UID=          # ваш user id (число); можно оставить пустым, тогда он узнается по токену
APP_PASSWORD=              # общий пароль на вход, пока не настроен Яндекс ID; пусто = без пароля (удобно дома)
# Вход для друзей через Яндекс ID (инструкция в README, раздел «Вход для друзей»).
YANDEX_ID_CLIENT_ID=       # ClientID приложения с oauth.yandex.ru
YANDEX_ID_CLIENT_SECRET=   # Client secret того же приложения
OWNER_LOGIN=               # ваш логин в Яндексе: вам показываются плейлисты по YANDEX_MUSIC_TOKEN
ALLOWED_LOGINS=            # логины друзей через запятую, например: boris, vera.ivanova
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
